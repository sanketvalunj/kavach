{
  "openapi": "3.1.0",
  "info": {
    "title": "Kavach EW Command Backend",
    "description": "Versioned backend contract for the hybrid Kavach EW Command application.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/simulation/state": {
      "get": {
